// TODO rework into Unsafe_Hybrid_array
#intrinsic
published /*sealed*/ class Raw_Hybrid_Array[any P ind nonwritable out, any T ind nonwritable out]
    // where move P
    // where move T
{
    // TODO declare named arguments
    #intrinsic
    published /*unsafe*/ protected init(mut self, ensure_prefix_zeroed: bool, count: size, ensure_zeroed: bool) { INTRINSIC(); }
    // TODO exchange_prefix()
    /// Unsafe because it could allow reading of uninitialized memory
    #intrinsic
    published /*unsafe*/ get prefix(self) -> aliasable P => INTRINSIC();
    #intrinsic
    published set prefix(mut self, prefix: P) => INTRINSIC();
    #intrinsic
    published get count(self) -> size => INTRINSIC();
    // TODO fn exchange(mut self, index: size, value: T) -> T
    #intrinsic
    published /*unsafe*/ fn get(self, index: size) -> aliasable T => INTRINSIC();
    #intrinsic
    published /*unsafe*/ fn set(mut self, index: size, value: T) => INTRINSIC();
}

// let x = move a.prefix = new_value();
