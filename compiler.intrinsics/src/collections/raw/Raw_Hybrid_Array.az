#Intrinsic
published /*sealed*/ class Raw_Hybrid_Array[any P ind nonwritable out, any T ind nonwritable out]
    // where move P
    // where move T
{
    // TODO declare named arguments
    #Intrinsic
    published /*unsafe*/ init(mut self, ensure_prefix_zeroed: bool, count: size, ensure_zeroed: bool) { INTRINSIC(); }
    /// Unsafe because it could allow reading of uninitialized memory
    #Intrinsic // TODO return type needs to create alias? i.e. if T is `iso Foo` then this returns `mut Foo` (but how to move out?)
    published /*unsafe*/ get prefix(self) -> P => INTRINSIC();
    #Intrinsic
    published set prefix(mut self, prefix: P) => INTRINSIC();
    #Intrinsic
    published get count(self) -> size => INTRINSIC();
    #Intrinsic
    published /*unsafe*/ fn get(readable self, index: size) -> aliasable T => INTRINSIC();
    #Intrinsic
    published /*unsafe*/ fn set(readable self, index: size, value: T) => INTRINSIC();
}

// let x = move a.prefix = new_value();
// But this is not a fully general functionality because it requires that the old value can be moved

