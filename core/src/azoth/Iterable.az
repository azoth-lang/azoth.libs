// TODO what is the right way to represent this?
// TODO it seems odd that the type parameter is independent. Perhaps what is needed is to extend
//      the collection types with Iterable[T] so that whatever the capability of T is at the time,
//      an aliasable version of it can be iterated.
public trait Iterable[independent T out]
{
    // TODO rename to .values()? and make it a property?
    published fn iterate(temp const self) -> mut Iterator[T];

    // TODO implicit conversion to `Iterator[T]`

    // --------------------- Iterator[T] forwards
    // TODO why does this compile? The `predicate` shouldn't be allowed to be shared with the `lent`
    // return value. Is it because function types are currently effectively immutable?
    published fn \where(temp const self, predicate: (aliasable T) -> bool) -> mut Iterator[T]
        => .iterate().\where(predicate);
}
