/// A collection whose elements can be randomly accessed by an index.
public trait Indexable_Collection[independent T readonly out] <: Collection[T], Reversible_Iterable[aliasable T]
{
    /// Take an element. If this element has ownership then what is left behind is an invalid value
    /// that must be overwritten or removed.
    /// O(1)
    published /* unsafe */ fn take(mut self, index: size) -> T;

    /// O(1)
    published fn get(self, index: size) -> aliasable T;
        // requires index < .count

    published fn set(mut self, index: size, value: T);
        // requires index < .count

    // TODO if `temp iso self` allows returning `iso Iterator` then shouldn't `temp const self` too?
    published fn iterate(temp const self) -> mut Iterator[aliasable T]
        => Indexable_Collection_Iterator[aliasable T](self);

    // TODO uncomment method
    /// An `Mutable_Iterable` that allows mutating the elements of this collection
    // published fn mutable_iterate(temp iso self) -> iso Iterator[/*mut Var[T]*/ aliasable T]
    //     => Indexable_Collection_Mutable_Iterator[aliasable T](move self);

    published fn unstable_sort(temp iso self, order: Ordering[aliasable T])
    {
        // TODO implement a high performance sort algo. See: introsort, pdqsort, ipnsort
        // TODO support `move` element types?
        // TODO think about safety of a comparison that modifies something about the elements, see
        //      https://github.com/Voultapher/sort-research-rs/blob/main/writeup/sort_safety/text.md
        .insertion_sort(0, .count-1, order);
    }

    fn insertion_sort(mut self, start_index: size, end_index: size, order: Ordering[aliasable T])
    {
        // TODO support using `with order`
        foreach i in (start_index+1)..end_index
        {
            // TODO support using foreach for this
            var j = i as! size;
            // TODO a way to remove the duplicate .get() calls?
            while j > 0 and order.compare(.get(j-1), .get(j)) > 0
            {
                // TODO add and use a swap method
                let t = .take(j-1);
                .set(j-1, .take(j));
                .set(j, t);
                j -= 1;
            }
        }
    }
}
