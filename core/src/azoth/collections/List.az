published class List[independent T readonly out] <: Indexable_Collection[T]
{
    var items: mut Buffer[T];

    published init(mut self)
    {
        .items = Buffer[T]();
    }

    // TODO named initializer: with_capacity
    published init(mut self, var capacity: size)
    {
        if capacity < 2 => capacity = 2;
        .items = Buffer[T](capacity);
    }

    published get capacity(self) -> size
        => .items.capacity;

    published get count(self) -> size
        => .items.count;

    published /*unsafe*/ fn take(mut self, index: size) -> T
        => .items.take(index);

    // Doesn't need `lent self` because T is independent
    published fn get(self, index: size) -> aliasable T
        // requires index < .count
        => .items.get(index);

    // Doesn't need `lent self` because T is independent
    published fn set(mut self, index: size, value: T)
        // requires index < .count
        => .items.set(index, value);

    published fn add(mut self, value: T)
        => .items.add(value);

    published fn remove_at(mut self, index: size) -> T
        // requires index < .count
        => .items.remove_at(index);

    published fn clear(mut self)
        => .items.clear();
}
