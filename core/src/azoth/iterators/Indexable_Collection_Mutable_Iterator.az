public class Indexable_Collection_Mutable_Iterator[aliasable T out] <: Iterator[T]
{
    let collection: temp iso Indexable_Collection[T];
    var index: size;

    public init(mut self, .collection)
    {
        .index = 0;
    }

    published fn size_hint(self) -> size => .collection.count - .index;

    // TODO `T` is restricted to `aliasable` so it shouldn't be needed here
    published fn \next(mut self) -> aliasable T?
    {
        // Note it is not a concern that the collection size could change, because it is `temp iso`
        // so nothing else can change it.
        if .index >= .collection.count
            { return none; }

        let item = .collection.get(.index);
        .index += 1;
        return item;
    }
}
