/// Represents a tagged union of a reference to struct type `T` and an integer value. The bit size
/// of the integer value is platform dependent. It must be a struct allocated on the heap because it
/// must be possible to know the exact type without a fat pointer. This class is not constant since
/// the referenced boxed struct does not need to be constant.
/// TODO: this is a place where it would be nice to have a type parameter that doesn't have an
/// associated capability.
#intrinsic
public struct Tagged_Reference[/*iso*/T]
